// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = AgentsMonitor
PRODUCT_DISPLAY_NAME = Agents Monitor
PRODUCT_BUNDLE_IDENTIFIER = com.roy.agentsmonitor
MARKETING_VERSION = 1.4.0
CURRENT_PROJECT_VERSION = 6

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Menu-bar agent: no Dock icon, no main window on launch.
INFOPLIST_KEY_LSUIElement = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/AgentsMonitor.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/AgentsMonitor.entitlements

// ==========================================
// Code Signing — ad-hoc, no Apple Developer account required.
// AgentsMonitor is a personal/local tool; sign to run locally.
// ==========================================
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =