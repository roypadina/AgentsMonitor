<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AgentsMonitor runs UN-SANDBOXED: it reads other apps' (Claude Code's)
	     keychain items to poll usage, writes its own OAuth lineage back to
	     the keychain for remote accounts, and registers a login item via
	     SMAppService. The sandbox would block cross-app keychain access. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- The release build is self-signed (no Team ID) with the hardened runtime, whose library
	     validation would refuse to load the embedded Sparkle.framework. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
